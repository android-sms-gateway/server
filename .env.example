# Environment Configuration Template for SMSGate Server
# Copy this file to .env and fill in the values for your deployment.
# This file documents the runtime variables used by the backend and worker.
# Do not commit .env files or real credentials.

# =============================================================================
# RUNTIME AND BOOTSTRAP
# =============================================================================

# Configuration file path
# Purpose: Selects the YAML configuration file loaded after .env values.
# Format: File path (absolute or relative to the process working directory)
# Default: config.yml
# Example: ./configs/config.yml
CONFIG_PATH=./configs/config.yml

# Debug logging
# Purpose: Enables debug-level logging from the shared logger.
# Format: Boolean (true|false)
# Default: false
# Example: true
DEBUG=false

# Optional process timezone
# Purpose: Sets the process timezone used by development tools and the Go runtime.
# This is separate from DATABASE__TIMEZONE.
# Format: IANA timezone name
# Default: System timezone
# Example: UTC
# TZ=UTC

# =============================================================================
# GATEWAY CONFIGURATION
# =============================================================================

# Gateway operation mode
# Purpose: Selects direct FCM delivery or private upstream delivery.
# Set this explicitly to private or public before starting the server.
# Format: public or private
# Default: public
# Example: private
GATEWAY__MODE=

# Private registration token
# Purpose: Authenticates new device registrations when private mode is enabled.
# Required for private mode; use a high-entropy value from a secret manager.
# Format: Opaque string
# Default: Empty
# Example: random-high-entropy-token
GATEWAY__PRIVATE_TOKEN=

# Private-mode upstream URL
# Purpose: Base URL used to relay push notifications in private mode.
# Format: Absolute URL
# Default: https://api.sms-gate.app/upstream/v1
# Example: https://api.sms-gate.app/upstream/v1
GATEWAY__UPSTREAM_URL=https://api.sms-gate.app/upstream/v1

# =============================================================================
# HTTP SERVER CONFIGURATION
# =============================================================================

# HTTP listen address
# Purpose: Address and port used by the HTTP server.
# Containers must listen on 0.0.0.0 rather than a loopback address.
# Format: host:port
# Default: :3000
# Example: 0.0.0.0:3000
HTTP__LISTEN=:3000

# Trusted proxy addresses
# Purpose: Enables forwarded-client IP handling for trusted reverse proxies.
# Format: Comma-separated IP addresses or CIDR ranges without spaces
# Default: Empty (no trusted proxies)
# Example: 127.0.0.1
# Example: 10.0.0.0/8
HTTP__PROXIES=

# Public API host
# Purpose: Hostname used when generating public API URLs and links.
# Do not include a scheme or path.
# Format: host[:port]
# Default: Empty (use the request hostname)
# Example: api.example.com
HTTP__API__HOST=

# Public API path prefix
# Purpose: Prefix used for the third-party and mobile API routes.
# Format: Absolute path beginning with /
# Default: /api
# Example: /api
HTTP__API__PATH=/api

# OpenAPI documentation
# Purpose: Enables the generated OpenAPI documentation endpoints.
# Keep disabled when the API documentation should not be publicly exposed.
# Format: Boolean (true|false)
# Default: false
# Example: true
HTTP__OPENAPI__ENABLED=false

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Supported databases: MySQL 8.0.13+ or MariaDB 10.2.7+
# MariaDB LTS is recommended for deployments.

# Database host
# Purpose: Hostname or IP address of the MySQL/MariaDB server.
# Format: Hostname or IP address
# Default: localhost
# Example: localhost
DATABASE__HOST=localhost

# Database port
# Purpose: TCP port of the MySQL/MariaDB server.
# Format: Integer
# Default: 3306
# Example: 3306
DATABASE__PORT=3306

# Database user
# Purpose: Username used to connect to the database.
# Format: String
# Default: sms
# Example: sms
DATABASE__USER=sms

# Database password
# Purpose: Password used to connect to the database.
# Required for a real deployment; use a random value from a secret manager.
# Format: Secret string
# Default: sms (unsafe development default)
# Example: replace-with-a-random-password
DATABASE__PASSWORD=

# Database name
# Purpose: Name of the MySQL/MariaDB database.
# Format: String
# Default: sms
# Example: sms
DATABASE__DATABASE=sms

# Database timezone
# Purpose: Timezone used for database operations and message TTL calculations.
# Format: IANA timezone name
# Default: UTC
# Example: UTC
DATABASE__TIMEZONE=UTC

# Database debug logging
# Purpose: Enables verbose database query logging.
# Format: Boolean (true|false)
# Default: false
# Example: false
DATABASE__DEBUG=false

# Maximum open database connections
# Purpose: Limits concurrent database connections; 0 uses automatic CPU-based sizing.
# Format: Nonnegative integer
# Default: 0
# Example: 4
DATABASE__MAX_OPEN_CONNS=0

# Maximum idle database connections
# Purpose: Limits idle database connections; 0 uses automatic CPU-based sizing.
# Format: Nonnegative integer
# Default: 0
# Example: 2
DATABASE__MAX_IDLE_CONNS=0

# =============================================================================
# FIREBASE CLOUD MESSAGING (FCM) CONFIGURATION
# =============================================================================

# Firebase service-account credentials
# Purpose: Authenticates direct FCM delivery in public mode.
# Required in public mode; unused in private mode. Supply the value through a
# secret manager rather than committing a service-account file.
# Format: Compact, single-line JSON service-account document
# Default: Empty
# Example: compact service-account JSON
FCM__CREDENTIALS_JSON=

# Push batching debounce
# Purpose: Sets the global interval used to batch queued push notifications.
# Values below 5 seconds are raised to the runtime minimum of 5 seconds.
# Format: Unsigned integer (seconds)
# Default: 0 (effective minimum 5 seconds)
# Example: 5
FCM__DEBOUNCE_SECONDS=5

# Push notification timeout
# Purpose: Limits how long the push client waits for a delivery operation.
# Values below 1 second are raised to the runtime minimum of 1 second.
# Format: Unsigned integer (seconds)
# Default: 0 (effective minimum 1 second)
# Example: 1
FCM__TIMEOUT_SECONDS=1

# =============================================================================
# SERVER-SENT EVENTS (SSE) CONFIGURATION
# =============================================================================

# SSE keep-alive period
# Purpose: Sends keep-alive pings to maintain open SSE connections.
# A value of 0 disables keep-alive pings.
# Format: Unsigned integer (seconds)
# Default: 15
# Example: 15
SSE__KEEP_ALIVE_PERIOD_SECONDS=15

# =============================================================================
# MESSAGES AND QUEUE CONFIGURATION
# =============================================================================

# Message cache TTL
# Purpose: Controls how long cached message data remains available.
# A value of 0 means no expiration.
# Format: Positive integer (seconds)
# Default: 300
# Example: 300
MESSAGES__CACHE_TTL_SECONDS=300

# Real-time message hashing interval
# Purpose: Controls the backend interval for hashing eligible message data.
# Format: Positive integer (seconds)
# Default: 60
# Example: 60
MESSAGES__HASHING_INTERVAL_SECONDS=60

# Maximum pending messages per device
# Purpose: Blocks new enqueueing when a device has reached the pending limit.
# Values less than or equal to 0 disable this limit.
# Format: Integer
# Default: 0 (disabled)
# Example: 100
MESSAGES__QUEUE__MAX_PENDING=0

# Maximum pending-message age
# Purpose: Blocks enqueueing when a device has messages older than this age.
# A value of 0s disables this check.
# Format: Go duration (for example, 30m or 1h)
# Default: 0s (disabled)
# Example: 1h
MESSAGES__QUEUE__MAX_PENDING_AGE=0s

# Failed-state threshold
# Purpose: Counts recent failed states and blocks enqueueing when the threshold is reached.
# This is a limit window, not a failed-message retention setting.
# Values less than or equal to 0 disable this check.
# Format: Integer
# Default: 0 (disabled)
# Example: 10
MESSAGES__QUEUE__MAX_FAILED=0

# Failed-state threshold window
# Purpose: Defines the time window used with MESSAGES__QUEUE__MAX_FAILED.
# Both values must be greater than 0 for the failed-state limit to be active.
# Format: Go duration (for example, 24h; d and w are not valid units)
# Default: 0s (disabled)
# Example: 24h
MESSAGES__QUEUE__MAX_FAILED_AGE=0s

# Queue-statistics refresh interval
# Purpose: Controls how often queue-limit statistics are refreshed.
# Format: Positive Go duration
# Default: 5s
# Example: 5s
MESSAGES__QUEUE__STATS_REFRESH_INTERVAL=5s

# Queue-statistics cache TTL
# Purpose: Controls how long refreshed queue-limit statistics are cached.
# Format: Positive Go duration
# Default: 60s
# Example: 60s
MESSAGES__QUEUE__STATS_CACHE_TTL=60s

# =============================================================================
# CACHE AND PUB/SUB CONFIGURATION
# =============================================================================

# Cache URL
# Purpose: Selects the backend cache implementation.
# Use a shared Redis instance when running multiple backend replicas.
# Format: memory:// or redis:// URL
# Default: memory://
# Example: memory://
# Example: redis://localhost:6379/0
CACHE__URL=memory://

# Pub/Sub URL
# Purpose: Selects the backend pub/sub implementation.
# Use a shared Redis instance when running multiple backend replicas.
# Format: memory:// or redis:// URL
# Default: memory://
# Example: memory://
# Example: redis://localhost:6379/1
PUBSUB__URL=memory://

# Pub/Sub buffer size
# Purpose: Sets the subscriber channel buffer size; 0 creates unbuffered channels.
# Format: Unsigned integer
# Default: 128
# Example: 128
PUBSUB__BUFFER_SIZE=128

# =============================================================================
# JWT AUTHENTICATION CONFIGURATION
# =============================================================================

# JWT signing secret
# Purpose: Signs and verifies JWT access and refresh tokens.
# An empty value disables JWT functionality; a non-empty value must be at least
# 32 bytes. Use a high-entropy value from a secret manager.
# Format: Secret string
# Default: Empty (JWT disabled)
# Example: random-high-entropy-secret
JWT__SECRET=

# JWT access-token lifetime
# Purpose: Controls how long an issued access token remains valid.
# Format: Positive Go duration
# Default: 15m
# Example: 15m
JWT__ACCESS_TTL=15m

# JWT refresh-token lifetime
# Purpose: Controls how long an issued refresh token remains valid.
# Must be greater than JWT__ACCESS_TTL when JWT is enabled.
# Format: Positive Go duration
# Default: 720h
# Example: 720h
JWT__REFRESH_TTL=720h

# JWT issuer
# Purpose: Sets the issuer claim included in issued tokens.
# Format: Stable string identifier
# Default: sms-gate.app
# Example: sms-gate.app
JWT__ISSUER=sms-gate.app

# =============================================================================
# OTP CONFIGURATION
# =============================================================================

# OTP authentication
# Purpose: Enables one-time codes for user/device registration flows.
# Format: Boolean (true|false)
# Default: true
# Example: true
OTP__ENABLED=true

# OTP code length
# Purpose: Sets the number of digits in generated one-time codes.
# Format: Integer (minimum 6)
# Default: 6
# Example: 6
OTP__LENGTH=6

# OTP lifetime
# Purpose: Controls how long a generated one-time code remains valid.
# Format: Positive integer (seconds)
# Default: 60
# Example: 60
OTP__TTL=60

# OTP generation retries
# Purpose: Limits collision retries when generating a one-time code.
# Format: Positive integer
# Default: 3
# Example: 3
OTP__RETRIES=3

# =============================================================================
# BACKGROUND WORKER CONFIGURATION
# =============================================================================
# These settings are used by the worker command. Duration values use Go syntax;
# use 24h, 168h, or 8760h rather than d or w.

# Message hashing task interval
# Purpose: Schedules periodic hashing of processed message content and phone numbers.
# Format: Go duration
# Default: 168h
# Example: 168h
TASKS__MESSAGES_HASHING__INTERVAL=168h

# Message cleanup task interval
# Purpose: Schedules deletion of messages that exceed the configured maximum age.
# Format: Go duration
# Default: 24h
# Example: 24h
TASKS__MESSAGES_CLEANUP__INTERVAL=24h

# Message cleanup maximum age
# Purpose: Sets the retention age for messages before cleanup removes them.
# Format: Go duration
# Default: 720h
# Example: 720h
TASKS__MESSAGES_CLEANUP__MAX_AGE=720h

# Device cleanup task interval
# Purpose: Schedules removal of inactive devices that exceed the maximum age.
# Format: Go duration
# Default: 24h
# Example: 24h
TASKS__DEVICES_CLEANUP__INTERVAL=24h

# Device cleanup maximum age
# Purpose: Sets the retention age for inactive devices before removal.
# Format: Go duration
# Default: 8760h
# Example: 8760h
TASKS__DEVICES_CLEANUP__MAX_AGE=8760h

# Token cleanup task interval
# Purpose: Schedules removal of tokens that are expired beyond the grace period.
# Format: Go duration
# Default: 24h
# Example: 24h
TASKS__TOKENS_CLEANUP__INTERVAL=24h

# Token cleanup grace period
# Purpose: Keeps recently expired tokens briefly before deleting them.
# Format: Go duration
# Default: 1h
# Example: 1h
TASKS__TOKENS_CLEANUP__MAX_AGE=1h

# Inbox cleanup task interval
# Purpose: Schedules removal of inbox messages that exceed the configured maximum age.
# Format: Go duration
# Default: 24h
# Example: 24h
TASKS__INBOX_CLEANUP__INTERVAL=24h

# Inbox cleanup maximum age
# Purpose: Sets the retention age for inbox messages and attachments before cleanup.
# Format: Go duration
# Default: 720h
# Example: 720h
TASKS__INBOX_CLEANUP__MAX_AGE=720h
